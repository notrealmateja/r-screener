run_module4 <- function(fund_data = NULL) {
  message("\n=== MODULE 4: QUANTITATIVE SCORING ENGINE ===\n")
  
  library(dplyr)
  library(readr)
  
  # Use passed data or read from CSV
  if (is.null(fund_data)) {
    fund_data <- read_csv("data/fundamentals_scored.csv", show_col_types = FALSE)
    mom_data <- read_csv("data/momentum_scored.csv", show_col_types = FALSE)
    df <- merge(fund_data, mom_data, by = "symbol", all = TRUE)
  } else {
    df <- fund_data
  }
  
  n <- nrow(df)
  message("Scoring ", n, " stocks...\n")
  
  # Z-score normalization function
  z_norm <- function(x, higher_is_better = TRUE) {
    valid <- x[!is.na(x) & is.finite(x)]
    if (length(valid) < 3 || all(valid == 0)) return(rep(50, length(x)))
    mu <- mean(valid)
    sig <- sd(valid)
    if (sig == 0) return(rep(50, length(x)))
    z <- pmax(pmin((x - mu) / sig, 3), -3)
    if (!higher_is_better) z <- -z
    score <- (z + 3) / 6 * 100
    score <- round(ifelse(is.na(x), 50, score), 1)
    return(score)
  }
  
  message("[Step 1] Z-score normalizing all metrics...\n")
  
  # Value metrics (lower P/E and P/B is better)
  df$z_pe <- z_norm(ifelse(df$pe_ratio <= 0 | df$pe_ratio > 200, NA, df$pe_ratio), FALSE)
  df$z_pb <- z_norm(ifelse(df$pb_ratio <= 0 | df$pb_ratio > 50, NA, df$pb_ratio), FALSE)
  
  # Quality metrics
  df$z_roe <- z_norm(df$roe, TRUE)
  df$z_de <- z_norm(df$debt_equity, FALSE)
  
  # Momentum metrics
  df$z_ret1m <- z_norm(df$ret_1m, TRUE)
  df$z_ret6m <- z_norm(df$ret_6m, TRUE)
  df$z_rsi <- z_norm(df$rsi14, TRUE)
  df$z_macd <- z_norm(df$macd_score, TRUE)
  
  message("[Step 2] Computing composite factor scores...\n")
  
  df <- df %>% mutate(
    # Simplified scores using only available metrics
    value_score = round((z_pe * 0.50 + z_pb * 0.50), 1),
    quality_score = round((z_roe * 0.60 + z_de * 0.40), 1),
    momentum_score = round((z_ret1m * 0.30 + z_ret6m * 0.30 + z_rsi * 0.20 + z_macd * 0.20), 1),
    
    # Overall composite score
    overall_score = round((value_score * 0.30 + quality_score * 0.30 + momentum_score * 0.40), 1)
  )
  
  message("[Step 3] Saving results...\n")
  
  write_csv(df, "data/master_scored.csv")
  message("Saved: data/master_scored.csv (", n, " stocks)\n")
  
  # Return top stocks
  top20 <- df %>%
    arrange(desc(overall_score)) %>%
    head(20) %>%
    select(symbol, price, overall_score, value_score, quality_score, momentum_score)
  
  message("=== MODULE 4 COMPLETE ===\n")
  message("Top 3 stocks: ", paste(top20$symbol[1:min(3,nrow(top20))], collapse=", "), "\n")
  
  return(df)
}

# Auto-run if sourced by master
if (exists("SOURCED_BY_MASTER")) results <- run_module4()
